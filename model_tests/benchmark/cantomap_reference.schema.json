{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/model-tests/cantomap-reference.schema.json",
  "title": "CantoMap benchmark reference",
  "type": "object",
  "required": [
    "schema_version",
    "slice_id",
    "language",
    "source",
    "clip",
    "annotation_policy",
    "speakers",
    "segments",
    "overlap_regions",
    "references",
    "counts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "slice_id": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "object",
      "required": ["bcp47", "name", "evaluation_category"]
    },
    "source": {
      "type": "object",
      "required": ["corpus", "revision", "eaf", "audio", "eaf_sha256", "audio_sha256"]
    },
    "clip": {
      "type": "object",
      "required": ["source_start_ms", "source_end_ms", "duration_ms", "prepared_audio"]
    },
    "annotation_policy": {
      "type": "object",
      "required": ["unit", "boundary_policy", "cer_normalization"]
    },
    "speakers": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "source_tiers"]
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "segment_id",
          "speaker",
          "start_ms",
          "end_ms",
          "source_start_ms",
          "source_end_ms",
          "text"
        ],
        "properties": {
          "segment_id": {"type": "string"},
          "speaker": {"type": "string"},
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "exclusiveMinimum": 0},
          "source_start_ms": {"type": "integer", "minimum": 0},
          "source_end_ms": {"type": "integer", "exclusiveMinimum": 0},
          "text": {
            "type": "object",
            "required": ["characters_raw", "characters_segmented", "characters_cer", "jyutping"]
          }
        }
      }
    },
    "overlap_regions": {
      "type": "array"
    },
    "references": {
      "type": "object",
      "required": ["chronological", "by_speaker"]
    },
    "counts": {
      "type": "object",
      "required": [
        "segments",
        "segments_by_speaker",
        "speaker_transitions",
        "cross_speaker_overlap_pairs"
      ]
    }
  }
}
